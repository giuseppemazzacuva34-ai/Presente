// Configurazione di Cloudflare Workers per la landing di Presente (piano gratuito).
// Cloudflare Workers Builds pubblica a ogni modifica su main.
{
  "name": "presente",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "./landing",
    "binding": "ASSETS",
    // "/" e "/grazie" passano dal Worker anche per il contatore delle visite (D43, solo totali).
    // "/" passa dal Worker per precompilare il codice dei link d'invito dei creator (?invito=CODICE)
    // e il campo nascosto del canale (?da=); "/da/*" sono i link per canale (D26).
    "run_worker_first": ["/", "/grazie", "/grazie.html", "/iscrizione", "/conteggio", "/da", "/da/*"]
  },
  // Dominio comprato il 27 ottobre 2026 su Cloudflare: il sito risponde anche su presenteincontri.app (e www).
  "routes": [
    { "pattern": "presenteincontri.app", "custom_domain": true },
    { "pattern": "www.presenteincontri.app", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "presente-lista",
      "database_id": "39ed969d-4ed5-46d0-8d31-091e20504dfc"
    }
  ],
  // Limite di frequenza per /iscrizione: 5 invii al minuto dalla stessa connessione (gratis, incluso nel piano Free).
  // namespace_id è un numero scelto da noi, unico nell'account Cloudflare.
  "ratelimits": [
    {
      "name": "LIMITE_ISCRIZIONI",
      "namespace_id": "47011",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  // Le iscrizioni restano chiuse finché l'informativa privacy (decisione D5) non è approvata e completata.
  // Per aprirle: cambiare "no" in "si" con una modifica su main.
  "vars": {
    "ISCRIZIONI_APERTE": "si",
    // Codici d'invito dei creator contati in /conteggio (per_codice), separati da virgola, es. "SILVIA,NEVADA".
    // Solo lettere e numeri, massimo 20 caratteri. Vuoto finché i codici non sono assegnati.
    "CODICI_INVITO": "",
    // Campagne utm contate per nome in /conteggio (D43); le altre finiscono in "altro". Separate da virgola.
    "CAMPAGNE_UTM": "lista_traffico"
  },
  // Anteprime dei rami (Worker Previews di Workers Builds, comando "npx wrangler preview"): il blocco "previews"
  // è obbligatorio, senza di esso la build di anteprima fallisce. Le anteprime non usano le impostazioni di produzione:
  // nessun database collegato e iscrizioni chiuse, così un'anteprima non tocca mai i dati reali della lista d'attesa.
  "previews": {
    "vars": {
      "ISCRIZIONI_APERTE": "no"
    }
  }
}
